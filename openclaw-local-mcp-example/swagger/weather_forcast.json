{
  "openapi": "3.0.0",
  "info": {
    "title": "기상 예보 초단기실황조회 API",
    "version": "1.0.1",
    "description": "기상청 단기예보 조회 서비스입니다. 초단기실황정보는 예보 구역에 대한 대표 AWS 관측값을, 초단기예보는 예보시점부터 6시간까지의 예보를, 단기예보는 예보기간을 글피까지 확장 및 예보단위를 상세화(3시간→1시간)하여 시공간적으로 세분화한 예보를 제공합니다."
  },
  "paths": {
    "/forecast": {
      "get": {
        "summary": "실황정보를 조회하기 위해 발표일자, 발표시각, 예보지점 X/Y 좌표 조건으로 자료구분코드/실황값 등을 조회",
        "parameters": [
          {
            "name": "ServiceKey",
            "in": "query",
            "required": true,
            "description": "공공데이터포털에서 발급받은 인증키",
            "schema": { "type": "string" }
          },
          {
            "name": "pageNo",
            "in": "query",
            "required": false,
            "description": "페이지 번호",
            "schema": {
              "type": "integer",
              "default": 1,
              "minimum": 1,
              "maximum": 9999
            }
          },
          {
            "name": "numOfRows",
            "in": "query",
            "required": false,
            "description": "한 페이지 결과 수",
            "schema": {
              "type": "integer",
              "default": 1000,
              "minimum": 1,
              "maximum": 9999
            }
          },
          {
            "name": "dataType",
            "in": "query",
            "required": false,
            "description": "요청 자료 형식(XML/JSON) (기본값: XML)",
            "schema": {
              "type": "string",
              "enum": ["XML", "JSON"],
              "default": "JSON"
            }
          },
          {
            "name": "base_date",
            "in": "query",
            "required": true,
            "description": "발표 날짜 (YYYYMMDD)",
            "schema": {
              "type": "string",
              "pattern": "^\\d{8}$",
              "maxLength": 8,
              "example": "20250814"
            }
          },
          {
            "name": "base_time",
            "in": "query",
            "required": true,
            "description": "발표 시각 (HHMM, 매 정시)",
            "schema": {
              "type": "string",
              "pattern": "^\\d{4}$",
              "maxLength": 4,
              "example": "0600"
            }
          },
          {
            "name": "nx",
            "in": "query",
            "required": true,
            "description": "예보지점 X 좌표값",
            "schema": {
              "type": "integer",
              "minimum": 0,
              "maximum": 99,
              "example": 55
            }
          },
          {
            "name": "ny",
            "in": "query",
            "required": true,
            "description": "예보지점 Y 좌표값",
            "schema": {
              "type": "integer",
              "minimum": 0,
              "maximum": 99,
              "example": 127
            }
          }
        ],
        "responses": {
          "200": {
            "description": "성공 응답",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ForecastResponse" },
                "examples": {
                  "success": {
                    "summary": "정상 응답 예시",
                    "value": {
                      "response": {
                        "header": {
                          "resultCode": "00",
                          "resultMsg": "OK"
                        },
                        "body": {
                          "dataType": "JSON",
                          "items": {
                            "item": [
                              {
                                "baseDate": "20250814",
                                "baseTime": "0600",
                                "category": "PTY",
                                "nx": 55,
                                "ny": 127,
                                "obsrValue": "1"
                              },
                              {
                                "baseDate": "20250814",
                                "baseTime": "0600",
                                "category": "REH",
                                "nx": 55,
                                "ny": 127,
                                "obsrValue": "99"
                              },
                              {
                                "baseDate": "20250814",
                                "baseTime": "0600",
                                "category": "RN1",
                                "nx": 55,
                                "ny": 127,
                                "obsrValue": "5"
                              },
                              {
                                "baseDate": "20250814",
                                "baseTime": "0600",
                                "category": "T1H",
                                "nx": 55,
                                "ny": 127,
                                "obsrValue": "24.2"
                              },
                              {
                                "baseDate": "20250814",
                                "baseTime": "0600",
                                "category": "UUU",
                                "nx": 55,
                                "ny": 127,
                                "obsrValue": "0"
                              },
                              {
                                "baseDate": "20250814",
                                "baseTime": "0600",
                                "category": "VEC",
                                "nx": 55,
                                "ny": 127,
                                "obsrValue": "0"
                              },
                              {
                                "baseDate": "20250814",
                                "baseTime": "0600",
                                "category": "VVV",
                                "nx": 55,
                                "ny": 127,
                                "obsrValue": "0"
                              },
                              {
                                "baseDate": "20250814",
                                "baseTime": "0600",
                                "category": "WSD",
                                "nx": 55,
                                "ny": 127,
                                "obsrValue": "0.1"
                              }
                            ]
                          },
                          "pageNo": 1,
                          "numOfRows": 1000,
                          "totalCount": 8
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": { "description": "잘못된 요청 파라미터" },
          "401": { "description": "인증 실패(잘못된 ServiceKey)" },
          "500": { "description": "서버 오류" }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ForecastResponse": {
        "type": "object",
        "properties": {
          "response": { "$ref": "#/components/schemas/ResponseEnvelope" }
        },
        "required": ["response"]
      },
      "ResponseEnvelope": {
        "type": "object",
        "properties": {
          "header": { "$ref": "#/components/schemas/ResponseHeader" },
          "body": { "$ref": "#/components/schemas/ResponseBody" }
        },
        "required": ["header", "body"]
      },
      "ResponseHeader": {
        "type": "object",
        "properties": {
          "resultCode": {
            "type": "string",
            "maxLength": 2,
            "description": "결과코드(예: 00=정상)",
            "example": "00"
          },
          "resultMsg": {
            "type": "string",
            "maxLength": 50,
            "description": "결과메시지",
            "example": "OK"
          }
        },
        "required": ["resultCode", "resultMsg"]
      },
      "ResponseBody": {
        "type": "object",
        "properties": {
          "dataType": {
            "type": "string",
            "enum": ["XML", "JSON"],
            "description": "응답자료형식",
            "example": "XML"
          },
          "items": { "$ref": "#/components/schemas/Items" },
          "pageNo": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9999,
            "description": "페이지번호",
            "example": 1
          },
          "numOfRows": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9999,
            "description": "한 페이지 결과 수",
            "example": 10
          },
          "totalCount": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9999,
            "description": "전체 결과 수",
            "example": 3
          }
        },
        "required": ["dataType", "items", "pageNo", "numOfRows", "totalCount"]
      },
      "Items": {
        "type": "object",
        "properties": {
          "item": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/ObservationItem" }
          }
        },
        "required": ["item"]
      },
      "ObservationItem": {
        "type": "object",
        "properties": {
          "baseDate": {
            "type": "string",
            "pattern": "^\\d{8}$",
            "maxLength": 8,
            "description": "발표일자(YYYYMMDD)",
            "example": "20210628"
          },
          "baseTime": {
            "type": "string",
            "pattern": "^\\d{4}$",
            "maxLength": 4,
            "description": "발표시각(HHMM, 매 정시)",
            "example": "0600"
          },
          "nx": {
            "type": "integer",
            "minimum": 0,
            "maximum": 999,
            "description": "입력한 예보지점 X 좌표",
            "example": 55
          },
          "ny": {
            "type": "integer",
            "minimum": 0,
            "maximum": 999,
            "description": "입력한 예보지점 Y 좌표",
            "example": 127
          },
          "category": {
            "type": "string",
            "maxLength": 3,
            "description": "자료구분코드",
            "enum": ["RN1", "T1H", "UUU", "VVV", "WSD", "PTY", "REH", "VEC"],
            "example": "RN1"
          },
          "obsrValue": {
            "type": "string",
            "description": "실황 값. 일부 항목(RN1, T1H, UUU, VVV, WSD)은 실수로 제공될 수 있음.",
            "example": "0",
            "pattern": "^-?\\d+(\\.\\d+)?$"
          }
        },
        "required": [
          "baseDate",
          "baseTime",
          "nx",
          "ny",
          "category",
          "obsrValue"
        ]
      }
    }
  }
}
