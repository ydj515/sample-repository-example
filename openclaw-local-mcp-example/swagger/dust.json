        "parameters": [
          {
            "name": "serviceKey",
            "in": "query",
            "required": true,
            "description": "공공데이터포털에서 발급받은 인증키",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "pageNo",
            "in": "query",
            "required": false,
            "description": "페이지 번호",
            "schema": {
              "type": "integer",
              "default": 1,
              "minimum": 1,
              "maximum": 9999
            }
          },
          {
            "name": "numOfRows",
            "in": "query",
            "required": false,
            "description": "한 페이지 결과 수",
            "schema": {
              "type": "integer",
              "default": 1000,
              "minimum": 1,
              "maximum": 9999
            }
          },
          {
            "name": "returnType",
            "in": "query",
            "required": false,
            "description": "요청 자료 형식(xml/json) (기본값: xml)",
            "schema": {
              "type": "string",
              "enum": [
                "xml",
                "json"
              ],
              "default": "json"
            }
          },
          {
            "name": "sidoName",
