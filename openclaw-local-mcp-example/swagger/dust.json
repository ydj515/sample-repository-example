  "components": {
    "schemas": {
      "DustResponse": {
        "type": "object",
        "properties": {
          "response": {
            "$ref": "#/components/schemas/ResponseEnvelope"
          }
        },
        "required": [
          "response"
        ]
      },
      "ResponseEnvelope": {
        "type": "object",
        "properties": {
          "header": {
            "$ref": "#/components/schemas/ResponseHeader"
          },
          "body": {
            "$ref": "#/components/schemas/ResponseBody"
          }
        },
        "required": [
          "header",
          "body"
        ]
      },
      "ResponseHeader": {
        "type": "object",
        "properties": {
          "resultCode": {
            "type": "string",
            "maxLength": 2,
            "description": "결과코드(예: 00=정상)",
            "example": "00"
          },
          "resultMsg": {
            "type": "string",
            "maxLength": 50,
            "description": "결과메시지",
            "example": "NORMAL_CODE"
          }
        },
        "required": [
          "resultCode",
          "resultMsg"
        ]
      },
      "ResponseBody": {
        "type": "object",
        "properties": {
          "dataType": {
            "type": "string",
            "enum": [
              "XML",
              "JSON"
            ],
            "description": "응답자료형식",
            "example": "XML"
          },
          "items": {
            "$ref": "#/components/schemas/Items"
          },
          "pageNo": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9999,
            "description": "페이지번호",
            "example": 1
          },
          "numOfRows": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9999,
            "description": "한 페이지 결과 수",
            "example": 10
          },
          "totalCount": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9999,
            "description": "전체 결과 수",
            "example": 3
          }
        },
        "required": [
          "dataType",
          "items",
          "pageNo",
          "numOfRows",
          "totalCount"
        ]
      },
      "Items": {
        "type": "object",
        "properties": {
          "item": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ObservationItem"
            }
          }
        },
        "required": [
          "item"
        ]
      },
      "ObservationItem": {
        "type": "object",
        "properties": {
          "stationName": {
            "type": "string",
            "description": "측정소명",
            "example": "중구"
          },
          "stationCode": {
            "type": "string",
            "description": "측정소 코드",
            "example": "111121"
          },
          "mangName": {
            "type": "string",
            "description": "측정망 정보",
            "example": "도시대기"
          },
          "sidoName": {
            "type": "string",
            "description": "시도명",
            "enum": [
              "전국",
              "서울",
              "부산",
              "대구",
              "인천",
              "광주",
              "대전",
              "울산",
              "경기",
              "강원",
              "충북",
              "충남",
              "전북",
              "전남",
              "경북",
              "경남",
              "제주",
              "세종"
            ],
            "example": "서울"
          },
          "dataTime": {
            "type": "string",
            "description": "측정일시 (YYYY-MM-DD HH:MM)",
            "example": "2020-11-25 11:00"
          },
          "so2Value": {
            "type": "number",
            "description": "아황산가스 농도",
            "example": 0.007
          },
          "coValue": {
            "type": "number",
            "description": "일산화탄소 농도",
            "example": 0.7
          },
          "o3Value": {
            "type": "number",
            "description": "오존 농도",
            "example": 0.043
          },
          "no2Value": {
            "type": "number",
            "description": "이산화질소 농도",
            "example": 0.043
          },
          "pm10Value": {
            "type": "number",
            "description": "미세먼지(PM10) 농도",
            "example": 68
          },
          "pm10Value24": {
            "type": "number",
            "description": "미세먼지(PM10) 24시간예측이동농도",
            "example": 56
          },
          "pm25Value": {
            "type": "number",
            "description": "미세먼지(PM2.5) 농도",
            "example": 39
          },
          "pm25Value24": {
            "type": "number",
            "description": "미세먼지(PM2.5) 24시간예측이동농도",
            "example": 26
          },
          "khaiValue": {
            "type": "integer",
            "description": "통합대기환경수치",
            "example": 76
          },
          "khaiGrade": {
            "type": "string",
            "description": "통합대기환경지수",
            "example": "2"
          },
          "so2Grade": {
            "type": "string",
            "description": "아황산가스 지수",
            "example": "1"
          },
          "coGrade": {
            "type": "string",
            "description": "일산화탄소 지수",
            "example": "1"
          },
          "o3Grade": {
            "type": "string",
            "description": "오존 지수",
            "example": "2"
          },
          "no2Grade": {
            "type": "string",
            "description": "이산화질소 지수",
            "example": "2"
          },
          "pm10Grade": {
            "type": "string",
            "description": "미세먼지(PM10) 24시간 등급자료",
            "example": "2"
          },
          "pm25Grade": {
            "type": "string",
            "description": "미세먼지(PM2.5) 24시간 등급자료",
            "example": "2"
          },
          "pm10Grade1h": {
            "type": "string",
            "description": "미세먼지(PM10) 1시간 등급자료",
            "example": "2"
          },
          "pm25Grade1h": {
            "type": "string",
            "description": "미세먼지(PM2.5) 1시간 등급자료",
            "example": "2"
          },
          "so2Flag": {
            "type": "string",
            "description": "아황산가스 플래그",
            "example": "장비점검"
          },
          "coFlag": {
            "type": "string",
            "description": "일산화탄소 플래그",
            "example": "장비점검"
          },
          "o3Flag": {
            "type": "string",
            "description": "오존 플래그",
            "example": "자료이상"
          },
          "no2Flag": {
            "type": "string",
            "description": "이산화질소 플래그",
            "example": "통신장애"
          },
          "pm10Flag": {
            "type": "string",
            "description": "미세먼지(PM10) 플래그",
            "example": "점검및교정"
          },
          "pm25Flag": {
            "type": "string",
            "description": "미세먼지(PM2.5) 플래그",
            "example": "점검및교정"
          }
        },
        "required": [
          "stationName",
          "stationCode",
          "mangName",
          "sidoName",
          "dataTime"
        ]
      }
    }
  }
