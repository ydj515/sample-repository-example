POST http://localhost:8080/set/add
Content-Type: application/json

{
  "baseRequest": {
    "key": "numbers"
  },
  "members": ["1", "2", "3"]
}

###
POST http://localhost:8080/set/add
Content-Type: application/json

{
  "baseRequest": {
    "key": "numbers2"
  },
  "members": ["2", "3", "4"]
}

###
GET http://localhost:8080/set/intersection?keys=numbers,numbers2
Content-Type: application/json

###
GET http://localhost:8080/set/union?keys=numbers,numbers2
Content-Type: application/json

###
GET http://localhost:8080/set/difference?keys=numbers,numbers2
Content-Type: application/json
